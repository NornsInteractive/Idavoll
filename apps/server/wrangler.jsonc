{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idavoll-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoomDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoomDO"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "idavoll-d1",
      "database_id": "idavoll-local-d1-placeholder"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "idavoll-config-kv-placeholder"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DRAWINGS_BUCKET",
      "bucket_name": "idavoll-drawings"
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
